{
  "name": "skill-seekers-ts",
  "version": "2.0.0",
  "description": "Convert documentation websites into Claude Code skills with intelligent scraping and AI enhancement",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "ai",
    "documentation",
    "scraper",
    "skill-builder"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@mendable/firecrawl-js": "^1.0.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "turndown": "^7.2.1",
    "winston": "^3.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
