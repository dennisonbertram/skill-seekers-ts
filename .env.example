# Firecrawl API Key (optional)
# Get your key at: https://www.firecrawl.dev/
# If not set, the CLI will use Cheerio as the default scraper
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Other optional environment variables
# (These are typically set via CLI flags or config file)

# Default output directory
# OUTPUT_DIR=./output

# Default rate limit (seconds)
# RATE_LIMIT=0.5

# Default max pages to scrape
# MAX_PAGES=500
